/control/verbose 1
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/run/initialize
/control/execute macros/scoring.mac
/gun/particle gamma
/gun/energy 1.332 MeV
/gun/position 0 0 -12 cm
/gun/direction 0 0 1
/run/beamOn 20000
/score/dumpQuantityToFile SiLV Edep resultados/energia_edep.csv
/score/dumpQuantityToFile SiLV GammaFlux resultados/energia_fluxo.csv
