# Energia depositada no detector de silicio
/score/create/realWorldLogVol SiLV
/score/quantity/energyDeposit Edep MeV
/score/close

# Fluencia de fotons no detector
/score/create/boxMesh DetectorFluxMesh
/score/mesh/boxSize 3 3 0.05 cm
/score/mesh/nBin 1 1 1
/score/mesh/translate/xyz 0 0 10 cm
/score/quantity/cellFlux GammaFlux percm2
/score/filter/particle SomenteGamma gamma
/score/close
